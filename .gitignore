# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
.vs/
.vscode/
*.egg-info/
dist/
*.pyc
# parallel workers race on the bytecode write and leave `<name>.pyc.<pid>` behind, which *.pyc misses
__pycache__/

mama/mama.spec
mama.cmake

packages/
bin/

# Local CMake config-overhead benchmark (clones + build dirs)
bench/repos/
bench/_out/

# pytest tmp_path artifacts (repo-local, see tests/conftest.py)
.pytest_tmp/
.coverage

# Claude Code agent worktrees (transient)
.claude/worktrees/

# Fingerprint of the last passing mama-style-review (see .claude/settings.json)
.claude/.review-passed

# Planning phase marker. While it exists, the Stop hook asks for no review.
.claude/.planning

# The diff the Stop hook last asked about, so it asks once and not on every stop.
.claude/.review-nagged
